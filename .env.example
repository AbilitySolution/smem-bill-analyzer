# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic
# Utilisée par Next.js pour l'ancien flux synchrone. La même valeur doit être
# ajoutée séparément aux secrets des Supabase Edge Functions (voir README).
ANTHROPIC_API_KEY=your-anthropic-key

# Benchmarks staging uniquement (ne jamais utiliser de compte ou documents client)
BENCHMARK_BASE_URL=http://localhost:3000
BENCHMARK_EMAIL=benchmark@example.com
BENCHMARK_PASSWORD=replace-with-a-staging-only-password
BENCHMARK_FILES_DIR=C:/path/to/synthetic-invoices
BENCHMARK_REPETITIONS=3

