{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/document-jobs/auto-save",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "30 5 * * *"
    }
  ],
  "functions": {
    "api/internal/generate-report.py": {
      "maxDuration": 300,
      "memory": 3009,
      "includeFiles": "{logo_smem.png,scripts/reports/**}"
    }
  }
}
